#!/bin/bash

ROOT=$(git rev-parse --show-toplevel)

if [[ ! -f $ROOT/inputs/words256.txt ]]; then
  echo "[INFO] Generating 'words256.txt'...";
  ff=$ROOT/inputs/words64.txt;
  cat $ff $ff $ff $ff > $ROOT/inputs/words256.txt;
fi

