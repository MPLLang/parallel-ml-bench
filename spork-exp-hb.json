{
  "globals": {
    "compiler": [
      // "mpl-spork",
      //"mpl-hb",
      "mpl"//,
      // "mlton",
      // "mpl-spork-eager",
      // "mpl-hb-eager"

      //"mlton-dc",
      //"mpl-no-hb-eager"
      //"cpp"
    ],
    "split": [
      "2way"//,
      //"3way"
      
      //"3way-slow-exn",
      //"3way-no-inl",
      //"3way-slow-exn-no-inl",
      //"3way-no-nest",
      //"2way-slow-exn",
      //"2way-no-inl",
      //"2way-slow-exn-no-inl"
    ],
    "warmup": [
      "5"
    ],
    "repeat": [
      "20"
    ],
    "procs": [
      "1",
      "10",
      "20",
      "30",
      "40",
      "50",
      "60",
      "70",
      "80"
    ]
  },

  "templates": [
    // single-core mlton
    {"match": {
        "compiler": "^mlton(-dc)?$",
        "procs": "^1$",
        "split": "^2way$"
     },
     "cmd": "bin/<bench>-ng.<compiler>.bin <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>",
     "tag": "<tag>",
     "bench": "<bench>-ng",
     "human": "<compiler>"
    },
    
    // pcall with manual grains
    {"match": {
        "compiler": "^mpl$",
        "split": "^2way$",
        "procs": "^(1|80)$"
     },
     "cmd": "bin/<bench>.<compiler>.bin @mpl <procs?procs {} ><set-affinity?set-affinity {} >-- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>",
     "tag": "<tag>",
     "bench": "<bench>",
     "human": "pcall-manual-grain-<compiler>"
    },
    
    // eager pcall with manual grains
    // {"match": {
    //     "compiler": "^mpl-no-hb-eager$",
    //     "split": "^2way$",
    //     "procs": "^(1|80)$"
    //  },
    //  "cmd": "bin/<bench>.<compiler>.bin @mpl heartbeat-us 10000000000 <procs?procs {} ><set-affinity?set-affinity {} >-- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
    //  "cwd": "mpl",
    //  "config": "<compiler>",
    //  "tag": "<tag>",
    //  "bench": "<bench>",
    //  "human": "pcall-no-hb-manual-grain-eager"
    // },

    {"match": {
        "compiler": "^mpl-hb-eager$",
        "split": "^2way$",
        "procs": "^(1|80)$"
     },
     "cmd": "bin/<bench>.<compiler>.bin @mpl heartbeat-us 10000000000 <procs?procs {} ><set-affinity?set-affinity {} >-- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>",
     "tag": "<tag>",
     "bench": "<bench>",
     "human": "pcall-hb-manual-grain-eager"
    },

    // pcall with auto grains
    {"match": {
        "compiler": "^mpl-hb$",
        "split": "^2way$",
        "procs": "^(1|80)$"
     },
     "cmd": "bin/<bench>-ng.<compiler>.bin @mpl <procs?procs {} ><set-affinity?set-affinity {} > -- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>",
     "tag": "<tag>",
     "bench": "<bench>-ng",
     "human": "pcall-auto-grain"
    },

    {"match": {
        "compiler": "^mpl-hb$",
        "split": "^3way$",
        "procs": "^(1|80)$"
     },
     "cmd": "bin/<bench>-ng.<compiler>-<split>.bin @mpl <procs?procs {} ><set-affinity?set-affinity {} > -- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>-<split>",
     "tag": "<tag>",
     "bench": "<bench>-ng",
     "human": "pcall-auto-grain-<split>"
    },

    // spork with manual grains
    {"match": {
        "compiler": "^mpl-spork$",
        "split": "^2way$",
        "procs": "^(1|80)$"
     },
     "cmd": "bin/<bench>.<compiler>-manual.bin @mpl <procs?procs {} ><set-affinity?set-affinity {} > -- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>-manual",
     "tag": "<tag>",
     "bench": "<bench>",
     "human": "<compiler>-manual-grain"
    },

    // eager spork with manual grains
    {"match": {
        "compiler": "^mpl-spork-eager$",
        "split": "^2way$",
        "procs": "^(1|80)$"
     },
     "cmd": "bin/<bench>.<compiler>-manual.bin @mpl heartbeat-us 10000000000 <procs?procs {} ><set-affinity?set-affinity {} > -- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>-manual",
     "tag": "<tag>",
     "bench": "<bench>",
     "human": "<compiler>-manual-grain-eager"
    },

    // spork variants with auto grains
    //{"match": {
    //    "compiler": "^mpl-spork$",
    //    "split": "^(3way-slow-exn|3way-no-inl|3way-slow-exn-no-inl|3way-no-nest)$",
    //    "procs": "^(1|80)$"
    // },
    // "cmd": "bin/<bench>-ng.<compiler>-<split>.bin @mpl <procs?procs {} ><set-affinity?set-affinity {} > -- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
    // "cwd": "mpl",
    // "config": "<compiler>-<split>",
    // "tag": "<tag>",
    // "bench": "<bench>-ng",
    // "human": "spork-auto-grain"
    //},

    // primary spork bench with auto grains and all procs
    {"match": {
        "compiler": "^mpl-spork$",
        //"split": "^3way$"
        "procs": "^(1|80)$"
     },
     "cmd": "bin/<bench>-ng.<compiler>-<split>.bin @mpl <procs?procs {} ><set-affinity?set-affinity {} > -- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>-<split>",
     "tag": "<tag>",
     "bench": "<bench>-ng",
     "human": "spork-auto-grain"
    },

    {"match": {
        "compiler": "^mpl-spork$",
        "split": "^3way$",
        "procs": "^(10|20|30|40|50|60|70)$"
     },
     "cmd": "bin/<bench>-ng.<compiler>-<split>.bin @mpl <procs?procs {} ><set-affinity?set-affinity {} > -- <args?{} ><args1?{} ><repeat?-repeat {} ><warmup?-warmup {} >",
     "cwd": "mpl",
     "config": "<compiler>-<split>",
     "tag": "<tag>",
     "bench": "<bench>-ng",
     "human": "spork-auto-grain"
    },

    {"match": {
        "compiler": "^cpp$",
        "procs": "(?!1$)",
        "split": "^2way$"
     },
     "cmd": "/home/cc/numactl/numactl -i all -- bin/<bench>.cpp.bin <args?{}> <args1?{}> -repeat 20 -warmup 5",
     "cwd": "cpp",
     "env": {"PARLAY_NUM_THREADS": "<procs>"},
     "config": "<compiler>",
     "human": "cpp"
    },

    {"match": {
        "compiler": "^cpp$",
        "procs": "1",
        "split": "^2way$"
     },
     "cmd": "bin/<bench>.cpp.bin <args?{}> <args1?{}> -repeat 20 -warmup 5",
     "cwd": "cpp",
     "env": {"PARLAY_NUM_THREADS": "<procs>"},
     "config": "<compiler>",
     "human": "cpp"
    }
  ],

